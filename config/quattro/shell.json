{
  "version": 1,
  "idle": {
    "screensaver": 0,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        { "id": "quattro.menu" },
        { "id": "quattro.workspaces" }
      ],
      "centerBegin": [
        { "id": "quattro.indicators" }
      ],
      "center": [
        {
          "id": "quattro.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerEnd": [
        { "id": "quattro.weather" }
      ],
      "right": [
        { "id": "quattro.tray" },
        { "id": "quattro.keyboard-layout" },
        { "id": "quattro.bluetooth" },
        { "id": "quattro.network" },
        { "id": "quattro.audio" },
        { "id": "quattro.power" }
      ]
    }
  },
  "plugins": []
}
