{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "background": "opaque",
    "layout": {
      "left": [
        {
          "id": "quattro.menu"
        },
        {
          "id": "quattro.workspaces"
        }
      ],
      "centerBegin": [
        {
          "id": "quattro.indicators"
        }
      ],
      "center": [
        {
          "id": "quattro.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "centerEnd": [
        {
          "id": "quattro.elsewhen"
        },
        {
          "id": "quattro.weather"
        },
        {
          "id": "quattro.system-update"
        }
      ],
      "right": [
        {
          "id": "quattro.tray"
        },
        {
          "id": "quattro.keyboard-layout"
        },
        {
          "id": "quattro.bluetooth"
        },
        {
          "id": "quattro.network"
        },
        {
          "id": "quattro.audio"
        },
        {
          "id": "quattro.monitor"
        },
        {
          "id": "quattro.power"
        }
      ]
    }
  },
  "dock": {
    "position": "bottom",
    "pinned": [
      "quattro-terminal",
      "quattro-browser",
      "org.gnome.Nautilus"
    ]
  },
  "plugins": []
}
