# Changes require a restart to take effect.

# UWSM doesn't source /etc/profile.d, so pull the env bootstrap in directly.
if [ -r "${QUATTRO_PATH:-$HOME/.local/share/quattro}/default/bash/env-bootstrap" ]; then
  . "${QUATTRO_PATH:-$HOME/.local/share/quattro}/default/bash/env-bootstrap"
elif [ -r /usr/share/quattro/default/bash/env-bootstrap ]; then
  . /usr/share/quattro/default/bash/env-bootstrap
fi

# Quattro session defaults. Users can override these in ~/.config/uwsm/default
# or, preferably, ~/.config/uwsm/env.d/*.
if [ -f "${QUATTRO_PATH%/}/default/uwsm/default" ]; then
  . "${QUATTRO_PATH%/}/default/uwsm/default"
else
  export TERMINAL=xdg-terminal-exec
  export EDITOR="quattro-launch-editor --inline"
fi

# Optional user overrides kept for compatibility with older installs.
[ -f "$HOME/.config/uwsm/default" ] && . "$HOME/.config/uwsm/default"

# Activate mise if present on the system
quattro-cmd-present mise && eval "$(mise activate bash --shims)"
