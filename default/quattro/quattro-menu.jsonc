{
  // Quattro menu definition (JSONC). IDs are object keys; dotted IDs imply hierarchy.
  // Fields: icon, label, action, aliases, title, when, checked, disabled, provider.
  // Providers available here: apps, languages, power-profiles.
  // Your own entries go in ~/.config/quattro/extensions/quattro-menu.jsonc.

  "apps": {"icon": "󰀻", "label": "Apps", "aliases": ["app", "applications"], "provider": "apps", "action": "quattro-shell quattro.dock apps"},
  "trigger": {"icon": "󱓞", "label": "Trigger"},
  "appearance": {"icon": "󰏘", "label": "Appearance", "aliases": ["style"]},
  "setup": {"icon": "", "label": "Setup", "aliases": ["settings"]},
  "update": {"icon": "", "label": "Restart", "aliases": ["restart", "refresh"]},
  "system": {"icon": "", "label": "System", "aliases": ["power-menu"]},
  "system.lock": {"icon": "", "label": "Lock", "action": "quattro-system-lock"},
  "system.suspend": {"icon": "󰒲", "label": "Suspend", "action": "systemctl suspend"},
  "system.hibernate": {"icon": "󰤁", "label": "Hibernate", "when": "[[ $(systemctl can-hibernate 2>/dev/null) == yes ]]", "action": "systemctl hibernate"},
  "system.logout": {"icon": "󰍃", "label": "Logout", "action": "quattro-system logout"},
  "system.reboot": {"icon": "󰜉", "label": "Reboot", "action": "quattro-system reboot"},
  "system.shutdown": {"icon": "󰐥", "label": "Shutdown", "action": "quattro-system shutdown"},
  "trigger.clipboard-history": {"icon": "󰅇", "label": "Clipboard History", "action": "quattro-shell shell summon quattro.clipboard"},
  "trigger.emoji": {"icon": "", "label": "Emoji", "aliases": ["emojis"], "action": "quattro-shell shell summon quattro.emojis"},
  "trigger.capture": {"icon": "", "label": "Capture", "aliases": ["screenshot"]},
  "trigger.capture.screenshot": {"icon": "", "label": "Screenshot", "action": "quattro-capture-screenshot"},
  "trigger.toggle": {"icon": "󰔎", "label": "Toggle", "aliases": ["toggles"]},
  "trigger.toggle.idle-lock": {"icon": "", "label": "Stay Awake (toggle)", "action": "quattro-shell idle toggle"},
  "trigger.toggle.notifications": {"icon": "󰂛", "label": "Silence Notifications (toggle)", "action": "quattro-shell notifications toggleDnd"},
  "trigger.toggle.nightlight": {"icon": "󰔎", "label": "Night Light (toggle)", "action": "quattro-toggle-nightlight"},
  "appearance.top-bar": {"icon": "󰍜", "label": "Menu Bar"},
  "appearance.top-bar.position": {"icon": "", "label": "Position Bar"},
  "appearance.top-bar.position.top": {"icon": "󰁝", "label": "Top Bar", "checked": "[[ $(quattro-bar position) == \"top\" ]]", "action": "quattro-bar position top"},
  "appearance.top-bar.position.bottom": {"icon": "󰁅", "label": "Bottom Bar", "checked": "[[ $(quattro-bar position) == \"bottom\" ]]", "action": "quattro-bar position bottom"},
  "appearance.top-bar.position.left": {"icon": "󰁍", "label": "Left Bar", "checked": "[[ $(quattro-bar position) == \"left\" ]]", "action": "quattro-bar position left"},
  "appearance.top-bar.position.right": {"icon": "󰁔", "label": "Right Bar", "checked": "[[ $(quattro-bar position) == \"right\" ]]", "action": "quattro-bar position right"},
  "appearance.top-bar.background": {"icon": "󰂵", "label": "Bar Background"},
  "appearance.top-bar.background.opaque": {"icon": "󰝤", "label": "Opaque Bar", "checked": "[[ $(quattro-bar background) == \"opaque\" ]]", "action": "quattro-bar background opaque"},
  "appearance.top-bar.background.glassy": {"icon": "󰂵", "label": "Glassy Bar", "checked": "[[ $(quattro-bar background) == \"glassy\" ]]", "action": "quattro-bar background glassy"},
  "appearance.top-bar.background.clear": {"icon": "󰝣", "label": "Clear Bar", "checked": "[[ $(quattro-bar background) == \"none\" ]]", "action": "quattro-bar background none"},
  "appearance.top-bar.clock": {"icon": "󰥔", "label": "Clock"},
  "appearance.top-bar.clock.time-24h": {"icon": "󰥔", "label": "14:30", "checked": "[[ $(quattro-bar get quattro.clock format) == \"HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"HH:mm\""},
  "appearance.top-bar.clock.time-12h": {"icon": "󰥔", "label": "2:30 PM", "checked": "[[ $(quattro-bar get quattro.clock format) == \"h:mm AP\" ]]", "action": "quattro-bar set quattro.clock format \"h:mm AP\""},
  "appearance.top-bar.clock.sunday-24h": {"icon": "󰥔", "label": "Sunday 14:30", "checked": "[[ $(quattro-bar get quattro.clock format) == \"dddd HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"dddd HH:mm\""},
  "appearance.top-bar.clock.date-24h": {"icon": "󰥔", "label": "Sun 3 May 14:30", "checked": "[[ $(quattro-bar get quattro.clock format) == \"ddd d MMM HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"ddd d MMM HH:mm\""},
  "appearance.top-bar.clock.iso": {"icon": "󰥔", "label": "2026-05-03 14:30", "checked": "[[ $(quattro-bar get quattro.clock format) == \"yyyy-MM-dd HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"yyyy-MM-dd HH:mm\""},
  "setup.language": {"icon": "", "label": "Language", "provider": "languages"},
  "setup.config": {"icon": "", "label": "Config"},
  "setup.config.shell": {"icon": "󰍜", "label": "Shell (shell.json)", "action": "quattro-launch-editor \"$HOME/.config/quattro/shell.json\""},
  "setup.config.env": {"icon": "󰍜", "label": "Environment (env)", "action": "quattro-launch-editor \"$HOME/.config/quattro/env\""},
  "setup.power-profile": {"icon": "󱐋", "label": "Power Profile", "provider": "power-profiles"},
  "update.shell": {"icon": "󰍜", "label": "Restart Shell", "action": "quattro-restart-shell"},
  "update.hardware": {"icon": "󰇅", "label": "Restart Hardware Service"},
  "update.hardware.audio": {"icon": "", "label": "Audio", "action": "quattro-terminal --hold bash -c 'systemctl --user restart pipewire wireplumber pipewire-pulse && echo Audio restarted'"},
  "update.hardware.bluetooth": {"icon": "󰂯", "label": "Bluetooth", "action": "quattro-terminal --hold sudo systemctl restart bluetooth"},
  "update.hardware.wifi": {"icon": "󱚾", "label": "Wi-Fi", "action": "quattro-terminal --hold sudo systemctl restart NetworkManager"}
}
