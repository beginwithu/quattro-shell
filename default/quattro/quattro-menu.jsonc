{
  // Quattro menu definition (JSONC). IDs are object keys; dotted IDs imply hierarchy.
  // Fields: icon, label, action, aliases, title, when, checked, disabled, provider.
  // Providers available here: apps, languages, power-profiles.
  // Your own entries go in ~/.config/quattro/extensions/quattro-menu.jsonc.

  "apps": {"icon": "󰀻", "label": "Apps", "aliases": ["app", "applications"], "provider": "apps", "action": "quattro-shell quattro.dock apps"},
  "trigger": {"icon": "󱓞", "label": "Trigger"},
  "appearance": {"icon": "󰏘", "label": "Appearance", "aliases": ["style"]},
  "appearance.theme": {"icon": "󰸌", "label": "Theme", "aliases": ["theme", "themes"]},
  "appearance.theme.catppuccin": {"icon": "󰸌", "label": "Catppuccin", "checked": "[[ $(quattro-theme-set current) == \"catppuccin\" ]]", "action": "quattro-theme-set catppuccin"},
  "appearance.theme.catppuccin-latte": {"icon": "󰸌", "label": "Catppuccin Latte", "checked": "[[ $(quattro-theme-set current) == \"catppuccin-latte\" ]]", "action": "quattro-theme-set catppuccin-latte"},
  "appearance.theme.ethereal": {"icon": "󰸌", "label": "Ethereal", "checked": "[[ $(quattro-theme-set current) == \"ethereal\" ]]", "action": "quattro-theme-set ethereal"},
  "appearance.theme.everforest": {"icon": "󰸌", "label": "Everforest", "checked": "[[ $(quattro-theme-set current) == \"everforest\" ]]", "action": "quattro-theme-set everforest"},
  "appearance.theme.flexoki-light": {"icon": "󰸌", "label": "Flexoki Light", "checked": "[[ $(quattro-theme-set current) == \"flexoki-light\" ]]", "action": "quattro-theme-set flexoki-light"},
  "appearance.theme.gruvbox": {"icon": "󰸌", "label": "Gruvbox", "checked": "[[ $(quattro-theme-set current) == \"gruvbox\" ]]", "action": "quattro-theme-set gruvbox"},
  "appearance.theme.hackerman": {"icon": "󰸌", "label": "Hackerman", "checked": "[[ $(quattro-theme-set current) == \"hackerman\" ]]", "action": "quattro-theme-set hackerman"},
  "appearance.theme.jade-horse": {"icon": "󰸌", "label": "Jade Horse", "checked": "[[ $(quattro-theme-set current) == \"jade-horse\" ]]", "action": "quattro-theme-set jade-horse"},
  "appearance.theme.kanagawa": {"icon": "󰸌", "label": "Kanagawa", "checked": "[[ $(quattro-theme-set current) == \"kanagawa\" ]]", "action": "quattro-theme-set kanagawa"},
  "appearance.theme.last-horizon": {"icon": "󰸌", "label": "Last Horizon", "checked": "[[ $(quattro-theme-set current) == \"last-horizon\" ]]", "action": "quattro-theme-set last-horizon"},
  "appearance.theme.lumon": {"icon": "󰸌", "label": "Lumon", "checked": "[[ $(quattro-theme-set current) == \"lumon\" ]]", "action": "quattro-theme-set lumon"},
  "appearance.theme.lupine": {"icon": "󰸌", "label": "Lupine", "checked": "[[ $(quattro-theme-set current) == \"lupine\" ]]", "action": "quattro-theme-set lupine"},
  "appearance.theme.matte-black": {"icon": "󰸌", "label": "Matte Black", "checked": "[[ $(quattro-theme-set current) == \"matte-black\" ]]", "action": "quattro-theme-set matte-black"},
  "appearance.theme.miasma": {"icon": "󰸌", "label": "Miasma", "checked": "[[ $(quattro-theme-set current) == \"miasma\" ]]", "action": "quattro-theme-set miasma"},
  "appearance.theme.nord": {"icon": "󰸌", "label": "Nord", "checked": "[[ $(quattro-theme-set current) == \"nord\" ]]", "action": "quattro-theme-set nord"},
  "appearance.theme.retro-82": {"icon": "󰸌", "label": "Retro 82", "checked": "[[ $(quattro-theme-set current) == \"retro-82\" ]]", "action": "quattro-theme-set retro-82"},
  "appearance.theme.ristretto": {"icon": "󰸌", "label": "Ristretto", "checked": "[[ $(quattro-theme-set current) == \"ristretto\" ]]", "action": "quattro-theme-set ristretto"},
  "appearance.theme.rose-pine": {"icon": "󰸌", "label": "Rose Pine", "checked": "[[ $(quattro-theme-set current) == \"rose-pine\" ]]", "action": "quattro-theme-set rose-pine"},
  "appearance.theme.solitude": {"icon": "󰸌", "label": "Solitude", "checked": "[[ $(quattro-theme-set current) == \"solitude\" ]]", "action": "quattro-theme-set solitude"},
  "appearance.theme.starship": {"icon": "󰸌", "label": "Starship", "checked": "[[ $(quattro-theme-set current) == \"starship\" ]]", "action": "quattro-theme-set starship"},
  "appearance.theme.tokyo-night": {"icon": "󰸌", "label": "Tokyo Night", "checked": "[[ $(quattro-theme-set current) == \"tokyo-night\" ]]", "action": "quattro-theme-set tokyo-night"},
  "appearance.theme.vantablack": {"icon": "󰸌", "label": "Vantablack", "checked": "[[ $(quattro-theme-set current) == \"vantablack\" ]]", "action": "quattro-theme-set vantablack"},
  "appearance.theme.white": {"icon": "󰸌", "label": "White", "checked": "[[ $(quattro-theme-set current) == \"white\" ]]", "action": "quattro-theme-set white"},
  "setup": {"icon": "", "label": "Setup", "aliases": ["settings"]},
  "update": {"icon": "", "label": "Restart", "aliases": ["restart", "refresh"]},
  "keybindings": {"icon": "", "label": "Keybindings", "aliases": ["keys", "shortcuts", "binds"], "provider": "keybindings", "when": "command -v hyprctl >/dev/null"},
  "system": {"icon": "", "label": "System", "aliases": ["power-menu"]},
  "system.lock": {"icon": "", "label": "Lock", "action": "quattro-system-lock"},
  "system.suspend": {"icon": "󰒲", "label": "Suspend", "action": "systemctl suspend"},
  "system.hibernate": {"icon": "󰤁", "label": "Hibernate", "when": "[[ $(systemctl can-hibernate 2>/dev/null) == yes ]]", "action": "systemctl hibernate"},
  "system.logout": {"icon": "󰍃", "label": "Logout", "action": "quattro-system logout"},
  "system.reboot": {"icon": "󰜉", "label": "Reboot", "action": "quattro-system reboot"},
  "system.shutdown": {"icon": "󰐥", "label": "Shutdown", "action": "quattro-system shutdown"},
  "trigger.clipboard-history": {"icon": "󰅇", "label": "Clipboard History", "action": "quattro-shell shell summon quattro.clipboard"},
  "trigger.emoji": {"icon": "", "label": "Emoji", "aliases": ["emojis"], "action": "quattro-shell shell summon quattro.emojis"},
  "trigger.capture": {"icon": "", "label": "Capture", "aliases": ["screenshot"]},
  "trigger.capture.screenshot": {"icon": "", "label": "Screenshot", "action": "quattro-capture-screenshot"},
  "trigger.capture.screenrecord": {"icon": "", "label": "Screenrecord", "when": "command -v wf-recorder >/dev/null"},
  "trigger.capture.screenrecord.stop": {"icon": "", "label": "Stop Screenrecording", "when": "quattro-capture-screenrecording --status", "action": "quattro-capture-screenrecording --stop-recording"},
  "trigger.capture.screenrecord.no-audio": {"icon": "", "label": "With no audio", "action": "quattro-capture-screenrecording", "when": "command -v wf-recorder >/dev/null && ! quattro-capture-screenrecording --status"},
  "trigger.capture.screenrecord.desktop-audio": {"icon": "", "label": "With desktop audio", "action": "quattro-capture-screenrecording --with-desktop-audio", "when": "command -v wf-recorder >/dev/null && ! quattro-capture-screenrecording --status"},
  "trigger.capture.text": {"icon": "󰴑", "label": "Text", "action": "quattro-capture-text", "when": "command -v tesseract >/dev/null"},
  "trigger.capture.qr": {"icon": "󰐲", "label": "QR Code", "action": "quattro-capture-qr", "when": "command -v zbarimg >/dev/null"},
  "trigger.capture.color": {"icon": "󰃉", "label": "Color", "action": "pkill hyprpicker || hyprpicker -a", "when": "command -v hyprpicker >/dev/null"},
  "trigger.share": {"icon": "", "label": "Share", "aliases": ["share"], "when": "command -v localsend >/dev/null"},
  "trigger.share.receive": {"icon": "󰥦", "label": "Receive", "action": "setsid -f localsend", "when": "command -v localsend >/dev/null"},
  "trigger.toggle": {"icon": "󰔎", "label": "Toggle", "aliases": ["toggles"]},
  "trigger.toggle.idle-lock": {"icon": "", "label": "Stay Awake (toggle)", "action": "quattro-shell idle toggle"},
  "trigger.toggle.notifications": {"icon": "󰂛", "label": "Silence Notifications (toggle)", "action": "quattro-shell notifications toggleDnd"},
  "trigger.toggle.nightlight": {"icon": "󰔎", "label": "Night Light (toggle)", "action": "quattro-toggle-nightlight"},
  "appearance.top-bar": {"icon": "󰍜", "label": "Menu Bar"},
  "appearance.top-bar.hide": {"icon": "󰈉", "label": "Hide Bar", "when": "[[ ! -f $HOME/.local/state/quattro/toggles/bar-off ]]", "action": "quattro-toggle-bar"},
  "appearance.top-bar.show": {"icon": "󰈈", "label": "Show Bar", "when": "[[ -f $HOME/.local/state/quattro/toggles/bar-off ]]", "action": "quattro-toggle-bar"},
  "appearance.top-bar.position": {"icon": "", "label": "Position Bar"},
  "appearance.top-bar.position.top": {"icon": "󰁝", "label": "Top Bar", "checked": "[[ $(quattro-bar position) == \"top\" ]]", "action": "quattro-bar position top"},
  "appearance.top-bar.position.bottom": {"icon": "󰁅", "label": "Bottom Bar", "checked": "[[ $(quattro-bar position) == \"bottom\" ]]", "action": "quattro-bar position bottom"},
  "appearance.top-bar.position.left": {"icon": "󰁍", "label": "Left Bar", "checked": "[[ $(quattro-bar position) == \"left\" ]]", "action": "quattro-bar position left"},
  "appearance.top-bar.position.right": {"icon": "󰁔", "label": "Right Bar", "checked": "[[ $(quattro-bar position) == \"right\" ]]", "action": "quattro-bar position right"},
  "appearance.top-bar.background": {"icon": "󰂵", "label": "Bar Background"},
  "appearance.top-bar.background.opaque": {"icon": "󰝤", "label": "Opaque Bar", "checked": "[[ $(quattro-bar background) == \"opaque\" ]]", "action": "quattro-bar background opaque"},
  "appearance.top-bar.background.glassy": {"icon": "󰂵", "label": "Glassy Bar", "checked": "[[ $(quattro-bar background) == \"glassy\" ]]", "action": "quattro-bar background glassy"},
  "appearance.top-bar.background.clear": {"icon": "󰝣", "label": "Clear Bar", "checked": "[[ $(quattro-bar background) == \"none\" ]]", "action": "quattro-bar background none"},
  "appearance.top-bar.indicators": {"icon": "󰋽", "label": "Bar Indicators"},
  "appearance.top-bar.indicators.battery-percentage-on": {"icon": "󰁹", "label": "Show Battery %", "when": "compgen -G '/sys/class/power_supply/BAT*' >/dev/null && [[ $(quattro-bar get quattro.power showPercentage) != true ]]", "action": "quattro-shell quattro.power togglePercentage"},
  "appearance.top-bar.indicators.battery-percentage-off": {"icon": "󰁹", "label": "Hide Battery %", "when": "compgen -G '/sys/class/power_supply/BAT*' >/dev/null && [[ $(quattro-bar get quattro.power showPercentage) == true ]]", "action": "quattro-shell quattro.power togglePercentage"},
  "appearance.top-bar.indicators.clock": {"icon": "󰥔", "label": "Clock"},
  "appearance.top-bar.indicators.clock.sunday-24h": {"icon": "󰥔", "label": "Sunday 14:30", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"dddd HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"dddd HH:mm\""},
  "appearance.top-bar.indicators.clock.sunday-12h": {"icon": "󰥔", "label": "Sunday 2:30 PM", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"dddd h:mm AP\" ]]", "action": "quattro-bar set quattro.clock format \"dddd h:mm AP\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-24h": {"icon": "󰥔", "label": "Sunday 14:30:05", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"dddd HH:mm:ss\" ]]", "action": "quattro-bar set quattro.clock format \"dddd HH:mm:ss\""},
  "appearance.top-bar.indicators.clock.sunday-seconds-12h": {"icon": "󰥔", "label": "Sunday 2:30:05 PM", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"dddd h:mm:ss AP\" ]]", "action": "quattro-bar set quattro.clock format \"dddd h:mm:ss AP\""},
  "appearance.top-bar.indicators.clock.time-24h": {"icon": "󰥔", "label": "14:30", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"HH:mm\""},
  "appearance.top-bar.indicators.clock.time-12h": {"icon": "󰥔", "label": "2:30 PM", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"h:mm AP\" ]]", "action": "quattro-bar set quattro.clock format \"h:mm AP\""},
  "appearance.top-bar.indicators.clock.date-24h": {"icon": "󰥔", "label": "Sun 3 May 14:30", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"ddd d MMM HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"ddd d MMM HH:mm\""},
  "appearance.top-bar.indicators.clock.date-12h": {"icon": "󰥔", "label": "Sun 3 May 2:30 PM", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"ddd d MMM h:mm AP\" ]]", "action": "quattro-bar set quattro.clock format \"ddd d MMM h:mm AP\""},
  "appearance.top-bar.indicators.clock.week": {"icon": "󰥔", "label": "3 May W18 2026", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"d MMMM 'W'ww yyyy\" ]]", "action": "quattro-bar set quattro.clock format \"d MMMM 'W'ww yyyy\""},
  "appearance.top-bar.indicators.clock.iso": {"icon": "󰥔", "label": "2026-05-03 14:30", "when": "[[ $(quattro-bar position) != \"left\" && $(quattro-bar position) != \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock format) == \"yyyy-MM-dd HH:mm\" ]]", "action": "quattro-bar set quattro.clock format \"yyyy-MM-dd HH:mm\""},
  "appearance.top-bar.indicators.clock.stacked-24h": {"icon": "󰥔", "label": "14 — 30", "when": "[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock verticalFormat) == $'HH\\n—\\nmm' ]]", "action": "quattro-bar set quattro.clock verticalFormat $'HH\\n—\\nmm'"},
  "appearance.top-bar.indicators.clock.stacked-12h": {"icon": "󰥔", "label": "2 — 30 PM", "when": "[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock verticalFormat) == $'h\\n—\\nmm\\nAP' ]]", "action": "quattro-bar set quattro.clock verticalFormat $'h\\n—\\nmm\\nAP'"},
  "appearance.top-bar.indicators.clock.stacked-date": {"icon": "󰥔", "label": "03 May W18 '26", "when": "[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock verticalFormat) == $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy' ]]", "action": "quattro-bar set quattro.clock verticalFormat $'dd\\nMMM\\n\\'W\\'ww\\n\\'\\'yy'"},
  "appearance.top-bar.indicators.clock.stacked-time": {"icon": "󰥔", "label": "14 30", "when": "[[ $(quattro-bar position) == \"left\" || $(quattro-bar position) == \"right\" ]]", "checked": "[[ $(quattro-bar get quattro.clock verticalFormat) == $'HH\\nmm' ]]", "action": "quattro-bar set quattro.clock verticalFormat $'HH\\nmm'"},
  "setup.language": {"icon": "", "label": "Language", "provider": "languages"},
  "setup.network": {"icon": "󰛳", "label": "Network", "aliases": ["network"]},
  "setup.network.dns": {"icon": "󰇖", "label": "DNS", "aliases": ["dns"]},
  "setup.network.dns.dhcp": {"icon": "󰩟", "label": "DHCP", "checked": "[[ \"$(quattro-dns)\" == \"DHCP\" ]]", "action": "quattro-dns DHCP"},
  "setup.network.dns.cloudflare": {"icon": "󰅟", "label": "Cloudflare", "checked": "[[ \"$(quattro-dns)\" == \"Cloudflare\" ]]", "action": "quattro-dns Cloudflare"},
  "setup.network.dns.google": {"icon": "󰊭", "label": "Google", "checked": "[[ \"$(quattro-dns)\" == \"Google\" ]]", "action": "quattro-dns Google"},
  "setup.network.dns.custom": {"icon": "", "label": "Custom", "checked": "[[ \"$(quattro-dns)\" == \"Custom\" ]]", "action": "quattro-launch-floating-terminal-with-presentation 'quattro-dns Custom'"},
  "setup.config": {"icon": "", "label": "Config"},
  "setup.config.shell": {"icon": "󰍜", "label": "Shell (shell.json)", "action": "quattro-launch-editor \"$HOME/.config/quattro/shell.json\""},
  "setup.config.env": {"icon": "󰍜", "label": "Environment (env)", "action": "quattro-launch-editor \"$HOME/.config/quattro/env\""},
  "setup.power-profile": {"icon": "󱐋", "label": "Power Profile", "provider": "power-profiles"},
  "update.shell": {"icon": "󰍜", "label": "Restart Shell", "action": "quattro-restart-shell"},
  "update.timezone": {"icon": "", "label": "Timezone", "action": "quattro-menu-timezone"},
  "update.password": {"icon": "", "label": "Password"},
  "update.password.user": {"icon": "", "label": "User", "action": "quattro-launch-floating-terminal-with-presentation passwd"},
  "update.hardware": {"icon": "󰇅", "label": "Restart Hardware Service"},
  "update.hardware.audio": {"icon": "", "label": "Audio", "action": "quattro-terminal --hold bash -c 'systemctl --user restart pipewire wireplumber pipewire-pulse && echo Audio restarted'"},
  "update.hardware.bluetooth": {"icon": "󰂯", "label": "Bluetooth", "action": "quattro-terminal --hold sudo systemctl restart bluetooth"},
  "update.hardware.wifi": {"icon": "󱚾", "label": "Wi-Fi", "action": "quattro-terminal --hold sudo systemctl restart NetworkManager"}
}
