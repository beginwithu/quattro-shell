#!/bin/bash

# quattro:summary=Set or read the night light temperature via hyprsunset
# quattro:args=<get | set <kelvin>>
#
# 6000 K and above counts as off.

IDENTITY=6000

[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || {
  echo "quattro-nightlight: Hyprland is not running" >&2
  exit 1
}

command -v hyprsunset >/dev/null 2>&1 && command -v hyprctl >/dev/null 2>&1 || {
  echo "quattro-nightlight: hyprsunset and hyprctl are required" >&2
  exit 2
}

detach() { setsid "$@" >/dev/null 2>&1 < /dev/null & }

set_temperature() {
  local temp=${1:-}
  [[ $temp =~ ^[0-9]+$ ]] || { echo "quattro-nightlight: not a temperature: $temp" >&2; exit 1; }

  if ! pgrep -x hyprsunset >/dev/null; then
    detach hyprsunset
    local i
    for (( i = 0; i < 20; i++ )); do
      hyprctl hyprsunset temperature >/dev/null 2>&1 && break
      sleep 0.05
    done
  fi

  hyprctl hyprsunset temperature "$temp" >/dev/null
  # Even daylight tints the screen, so off also restores the identity matrix.
  (( temp >= IDENTITY )) && hyprctl hyprsunset identity >/dev/null
  return 0
}

get_temperature() {
  pgrep -x hyprsunset >/dev/null || exit 1
  local reply
  reply=$(hyprctl hyprsunset temperature 2>/dev/null)
  if [[ $reply =~ [0-9]+ ]]; then
    echo "${BASH_REMATCH[0]}"
  else
    exit 1
  fi
}

case "${1:-}" in
  get) get_temperature ;;
  set) set_temperature "${2:-}" ;;
  *) echo "Usage: quattro-nightlight <get | set <kelvin>>" >&2; exit 1 ;;
esac
