#!/bin/bash

# quattro:summary=Install Microsoft Outlook, Word, Excel, PowerPoint, Teams, and OneDrive as web apps.

set -e

ICONS="https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png"

echo "Installing Microsoft Outlook..."
quattro-webapp-install "Microsoft Outlook" "https://outlook.office.com/mail/" "$ICONS/microsoft-outlook.png"

echo "Installing Microsoft Word..."
quattro-webapp-install "Microsoft Word" "https://word.cloud.microsoft/" "$ICONS/microsoft-word.png"

echo "Installing Microsoft Excel..."
quattro-webapp-install "Microsoft Excel" "https://excel.cloud.microsoft/" "$ICONS/microsoft-excel.png"

echo "Installing Microsoft PowerPoint..."
quattro-webapp-install "Microsoft PowerPoint" "https://powerpoint.cloud.microsoft/" "$ICONS/microsoft-powerpoint.png"

echo "Installing Microsoft Teams..."
quattro-webapp-install "Microsoft Teams" "https://teams.cloud.microsoft/" "$ICONS/microsoft-teams.png"

echo "Installing Microsoft OneDrive..."
quattro-webapp-install "Microsoft OneDrive" "https://www.office.com/launch/onedrive" "$ICONS/microsoft-onedrive.png"

echo ""
echo "You can now find Microsoft Outlook, Word, Excel, PowerPoint, Teams, and OneDrive using the app launcher (SUPER + SPACE)"
