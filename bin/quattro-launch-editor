#!/bin/bash

# quattro:summary=Launch the default editor selected via Quattro defaults.
# quattro:args=[--inline] <path>

default_editor="$HOME/.local/state/quattro/defaults/editor"

if [[ ${1:-} == "--inline" ]]; then
  inline=true
  shift
else
  inline=false
fi

if [[ -f $default_editor ]]; then
  read -r editor <"$default_editor"
else
  editor="plain"
fi

# sublime-text-4 ships `subl` on PATH, not `sublime_text`.
[[ $editor == sublime_text ]] && editor=subl

quattro-cmd-present "$editor" || editor="nvim"

# Plain is a window, so a session without a display (SSH, a TTY) edits in vi
# instead, which every install has.
[[ ${editor##*/} == plain && -z ${WAYLAND_DISPLAY:-} ]] && editor="vi"

case "${editor##*/}" in
plain)
  # Plain runs until its window closes, so $EDITOR (git commit, sudoedit)
  # waits for it inline.
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec setsid uwsm-app -- "$editor" -- "$@"
  fi
  ;;
nvim | vim | vi | nano | micro | hx | helix | fresh)
  if [[ $inline == "true" ]]; then
    exec "$editor" -- "$@"
  else
    exec quattro-launch-tui "$editor" -- "$@"
  fi
  ;;
*)
  exec setsid uwsm-app -- "$editor" -- "$@"
  ;;
esac
