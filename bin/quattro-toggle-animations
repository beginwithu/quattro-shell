#!/bin/bash

# quattro:summary=Toggle animations, blur and shadows, which are slow without a GPU
# quattro:args=[toggle|on|off]
# quattro:examples=quattro toggle animations | quattro toggle animations off | quattro toggle animations on

case ${1:-toggle} in
toggle)
  if quattro-hyprland-animations-off; then
    animations=on
  else
    animations=off
  fi
  ;;
on | off) animations=$1 ;;
*)
  echo "Usage: quattro-toggle-animations [toggle|on|off]" >&2
  exit 1
  ;;
esac

# A session that renders on the CPU turns animations off by itself
# (default/hypr/software-rendering.lua). Turning them on there is remembered for
# later sessions too, and has to be in place before the toggle reloads Hyprland.
without_gpu="$HOME/.local/state/quattro/toggles/animations-without-gpu"

# The flag records animations being off, so on and off swap on the way through.
if [[ $animations == "on" ]]; then
  if [[ -e $XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/quattro-software-rendering ]]; then
    mkdir -p "${without_gpu%/*}"
    touch "$without_gpu"
  fi
  quattro-hyprland-toggle no-animations off
else
  rm -f "$without_gpu"
  quattro-hyprland-toggle no-animations on
fi

if quattro-hyprland-animations-off; then
  quattro-notification-send -g 󰗘 "$(quattro-i18n animations.disabled)"
else
  quattro-notification-send -g 󰗘 "$(quattro-i18n animations.enabled)"
fi
