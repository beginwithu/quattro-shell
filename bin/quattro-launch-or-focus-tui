#!/bin/bash

# quattro:summary=Launch a TUI or focus an existing terminal window for it
# quattro:args=[--app-id=<app-id>] <command> [args...]

if [[ ${1:-} == --app-id=* ]]; then
  APP_ID="${1#--app-id=}"
else
  APP_ID="org.quattro.$(basename "$1")"
fi

LAUNCH_COMMAND="quattro-launch-tui $@"

exec quattro-launch-or-focus "$APP_ID" "$LAUNCH_COMMAND"
