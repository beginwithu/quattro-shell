#!/bin/bash

# quattro:summary=Clear the shell update indicator after an update
# quattro:hidden=true

# quattro-update now clears the indicator itself. This stays for an update
# started by an older quattro-update: its pipeline was parsed before the
# upgrade replaced it, and still calls this right after a full upgrade that
# went through, so there is nothing left for the indicator to show.
quattro-shell -q quattro.system-update clear
