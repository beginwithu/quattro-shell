#!/bin/bash

# quattro:summary=Open the Quattro Discord community in the Discord app or a browser.

invite="https://discord.gg/tXFUdasqhY"

if quattro-cmd-present discord; then
  exec setsid uwsm-app -- discord --url -- "discord://-/invite/${invite##*/}"
else
  exec quattro-launch-webapp "$invite"
fi
