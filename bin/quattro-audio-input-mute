#!/bin/bash

# quattro:summary=Toggle microphone mute. Drives the hardware mic-mute LED on laptops that expose one.

wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle >/dev/null

if wpctl get-volume @DEFAULT_AUDIO_SOURCE@ | grep -q MUTED; then
  quattro-brightness-keyboard-mute on
  quattro-osd -i microphone-muted -m "$(quattro-i18n audio.micMuted)"
else
  quattro-brightness-keyboard-mute off
  quattro-osd -i microphone -m "$(quattro-i18n audio.micOn)"
fi
