#!/bin/bash

# quattro:summary=Restart the Quattro shell
# quattro:examples=quattro-restart-shell

QUATTRO_PATH=${QUATTRO_PATH:-$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)}
export QUATTRO_PATH
case ":$PATH:" in *":$QUATTRO_PATH/bin:"*) ;; *) export PATH="$QUATTRO_PATH/bin:$PATH" ;; esac

[[ -f $QUATTRO_PATH/shell/shell.qml ]] || { echo "Quattro shell config not found: $QUATTRO_PATH/shell" >&2; exit 1; }

# Restarting a live lock client would drop the lock screen and leave the session
# behind the compositor's lock failsafe, so refuse while locked.
locking=$(QUATTRO_SHELL_IPC_TIMEOUT=0.5s quattro-shell lock status 2>/dev/null | jq -r '.secure or .requested' 2>/dev/null)
if [[ $locking == true ]]; then
  echo "Refusing to restart the Quattro shell while the session is locked." >&2
  exit 1
fi

while timeout 30 quickshell kill -p "$QUATTRO_PATH/shell" --any-display >/dev/null 2>&1; do :; done

# Detached, so it outlives the terminal or menu entry that asked for the restart.
setsid quattro-launch-shell >/dev/null 2>&1 < /dev/null &

deadline=$((SECONDS + 60))
while (( SECONDS < deadline )); do
  if QUATTRO_SHELL_IPC_TIMEOUT=0.5s quattro-shell shell ping >/dev/null 2>&1; then
    exit 0
  fi
  sleep 0.1
done
echo "Quattro shell did not become ready after restart." >&2
exit 1
