#!/bin/bash

# quattro:summary=Remove Steam and all of its game libraries, configs, and caches.
# quattro:requires-sudo=true

set -e

quattro-lifecycle-dispatch pre-remove steam
quattro-pkg-drop steam

rm -rf \
  "$HOME/.steam" \
  "$HOME/.local/share/Steam" \
  "$HOME/.config/steam" \
  "$HOME/.cache/steam"

echo ""
echo "Steam and its data have been removed."
