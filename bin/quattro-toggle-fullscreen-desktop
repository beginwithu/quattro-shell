#!/bin/bash

# quattro:summary=Toggle a full screen desktop: hide the top bar and remove the window gaps together
# quattro:args=[toggle|on|off]
# quattro:examples=quattro toggle fullscreen desktop | quattro toggle fullscreen desktop off | quattro toggle fullscreen desktop on

ACTION="${1:-toggle}"

case $ACTION in
  toggle|"")
    # Only leave full screen when both halves are already in it, so a lone bar
    # or a lone gap toggle is pulled into line rather than flipped away.
    if quattro-toggle-enabled bar-off && quattro-hyprland-toggle-enabled window-no-gaps; then
      ACTION="off"
    else
      ACTION="on"
    fi
    ;;
  on|off) ;;
  *)
    echo "Usage: quattro-toggle-fullscreen-desktop [toggle|on|off]" >&2
    exit 1
    ;;
esac

quattro-toggle-bar "$ACTION"
quattro-hyprland-toggle window-no-gaps "$ACTION"
