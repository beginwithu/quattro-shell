#!/bin/bash

# quattro:summary=Install Heroic Games Launcher (Epic, GOG, Amazon Prime Gaming) with graphics drivers.
# quattro:requires-sudo=true

set -e

echo "Installing Heroic Games Launcher..."
quattro-pkg-add heroic-games-launcher-bin
quattro-install-gaming-gpu-lib32

setsid uwsm-app -- gtk-launch heroic >/dev/null 2>&1 &
