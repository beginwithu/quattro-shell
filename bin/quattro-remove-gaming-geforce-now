#!/bin/bash

# quattro:summary=Remove the GeForce NOW Flatpak app and its data.
# quattro:group=remove
# quattro:name=gaming geforce-now

set -e

if quattro-cmd-present flatpak && flatpak info com.nvidia.geforcenow &>/dev/null; then
  flatpak uninstall -y --delete-data com.nvidia.geforcenow
fi

echo ""
echo "GeForce NOW removed."
