#!/bin/bash

# quattro:summary=Run a command in whichever terminal is installed
# quattro:args=[--hold] <command> [args...]
#
# Order: $QUATTRO_TERMINAL, $TERMINAL, xdg-terminal-exec, then the usual suspects.

hold=0
[[ ${1:-} == --hold ]] && { hold=1; shift; }
(( $# > 0 )) || { echo "Usage: quattro-terminal [--hold] <command> [args...]" >&2; exit 1; }

if (( hold )); then
  set -- bash -c '"$@"; status=$?; echo; read -rn1 -p "Press any key to close"; exit $status' _ "$@"
fi

run() {
  case "$(basename "$1")" in
    wezterm) local t=$1; shift; exec "$t" start -- "$@" ;;
    gnome-terminal|kgx|ptyxis) local t=$1; shift; exec "$t" -- "$@" ;;
    xdg-terminal-exec) exec "$@" ;;
    *) local t=$1; shift; exec "$t" -e "$@" ;;
  esac
}

for candidate in "${QUATTRO_TERMINAL:-}" "${TERMINAL:-}"; do
  [[ -n $candidate ]] && command -v "${candidate%% *}" >/dev/null 2>&1 && run $candidate "$@"
done
for candidate in xdg-terminal-exec foot kitty alacritty ghostty wezterm konsole gnome-terminal ptyxis xfce4-terminal xterm; do
  command -v "$candidate" >/dev/null 2>&1 && run "$candidate" "$@"
done
echo "quattro-terminal: no terminal found; set QUATTRO_TERMINAL" >&2
exit 1
