#!/bin/bash

# quattro:summary=Show or set the glyph forms for Chinese, Japanese, and Korean text
# quattro:args=[jp|kr|sc|tc|hk|default]
# quattro:examples=quattro font cjk | quattro font cjk jp | quattro font cjk default

set -euo pipefail

# Also seeded by the first CJK input method or language chosen. Tagged text and
# a CJK session language keep their own forms regardless.
preference=${XDG_CONFIG_HOME:-$HOME/.config}/fontconfig/conf.d/50-quattro-input-method.conf

case "${1:-}" in
"")
  variant=""
  if [[ -f $preference ]]; then
    variant=$(sed -n 's|.*<family>Noto Sans CJK \([A-Z]*\)</family>.*|\1|p' "$preference" | head -n 1)
  fi
  variant=${variant,,}
  echo "${variant:-default}"
  ;;
jp | kr | sc | tc | hk | default)
  /usr/bin/python3 "$QUATTRO_PATH/default/input-methods/configure.py" font "$1"
  quattro-restart-shell
  quattro-notification-send -g  "$(quattro-i18n font.cjkChanged)" "$(quattro-i18n font.restartAppsToSeeChange)"
  ;;
*)
  echo "Usage: quattro-font-cjk [jp|kr|sc|tc|hk|default]" >&2
  exit 1
  ;;
esac
