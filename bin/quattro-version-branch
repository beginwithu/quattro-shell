#!/bin/bash

# quattro:summary=Print the active Quattro dev-link git branch
# quattro:hidden=true

quattro_path=${QUATTRO_PATH:-/usr/share/quattro}
quattro_path=${quattro_path%/}

[[ $quattro_path != "/usr/share/quattro" ]] || exit 1

branch=$(git -C "$quattro_path" branch --show-current 2>/dev/null || true)
if [[ -z $branch ]]; then
  hash=$(git -C "$quattro_path" rev-parse --short HEAD 2>/dev/null || true)
  [[ -n $hash ]] || exit 1
  branch="detached@$hash"
fi

echo "$branch"
