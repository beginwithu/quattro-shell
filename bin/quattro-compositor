#!/bin/bash

# quattro:summary=Hyprland compositor helper: workspace focus, focused output, and DPMS
# quattro:args=<focus-workspace <id> [output] | focused-output | dpms on|off>

need() {
  command -v "$1" >/dev/null 2>&1 || {
    echo "quattro-compositor: '$1' is required" >&2
    exit 2
  }
}

[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || {
  echo "quattro-compositor: Hyprland is not running" >&2
  exit 1
}

dispatch() {
  [[ $(hyprctl dispatch "$@" 2>&1) == ok ]]
}

focus_workspace() {
  local id=${1:-}
  [[ -n $id ]] || exit 1
  need hyprctl
  local safe_id=${id//\\/\\\\}
  safe_id=${safe_id//\"/\\\"}
  # hyprlang configs take `workspace N`; Lua configs take a dispatch expression.
  dispatch workspace "$id" || dispatch "hl.dsp.focus({ workspace = \"$safe_id\" })"
}

focused_output() {
  need hyprctl
  need jq
  hyprctl -j monitors 2>/dev/null | jq -r '.[] | select(.focused) | .name' | head -n1
}

dpms() {
  need hyprctl
  case "${1:-}" in
    off)
      dispatch dpms off || dispatch 'hl.dsp.dpms({ action = "disable" })'
      ;;
    on)
      # Skip the dispatch when every active display is already lit: a redundant
      # DPMS enable right after system resume forces another modeset, which blanks
      # the panel for a beat (visible flash at the unlock screen).
      if command -v jq >/dev/null 2>&1 && hyprctl -j monitors 2>/dev/null | jq -e 'length > 0 and all(.[]; .dpmsStatus == true)' >/dev/null 2>&1; then
        return 0
      fi
      dispatch dpms on || dispatch 'hl.dsp.dpms({ action = "enable" })'
      ;;
    *)
      echo "Usage: quattro-compositor dpms <on|off>" >&2
      exit 1
      ;;
  esac
  return 0
}

case "${1:-}" in
  focused-output) focused_output ;;
  dpms) shift; dpms "$@" ;;
  focus-workspace) shift; focus_workspace "$@" ;;
  *) echo "Usage: quattro-compositor <focus-workspace <id> [output] | focused-output | dpms on|off>" >&2; exit 1 ;;
esac
