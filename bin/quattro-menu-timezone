#!/bin/bash

# quattro:summary=Select and set the system timezone
# quattro:group=menu
# quattro:name=timezone

set -e

timezone=$(timedatectl list-timezones | quattro-menu-select "$(quattro-i18n timezone.setTitle)" -- --width 520 --maxheight 520) || exit 1
sudo timedatectl set-timezone "$timezone"
quattro-shell -q quattro.clock refresh
quattro-notification-send "$(quattro-i18n timezone.changed "$timezone")"
