#!/bin/bash

# quattro:summary=Launch a terminal in the active terminal's current directory
# quattro:args=[--pid=<terminal-pid>] [command...]

pid=""
if [[ ${1:-} == --pid=* ]]; then
  pid=${1#--pid=}
  shift
fi

exec setsid uwsm-app -- xdg-terminal-exec --dir="$(quattro-cmd-terminal-cwd "$pid")" "$@"
