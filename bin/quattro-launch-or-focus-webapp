#!/bin/bash

# quattro:summary=Launch or focus on a given web app identified by the window-pattern.
# quattro:args=<window-pattern> <url-and-flags...>

if (($# == 0)); then
  echo "Usage: quattro-launch-or-focus-webapp [window-pattern] [url-and-flags...]"
  exit 1
fi

WINDOW_PATTERN="$1"
shift
LAUNCH_COMMAND="quattro-launch-webapp $@"

exec quattro-launch-or-focus "$WINDOW_PATTERN" "$LAUNCH_COMMAND"
