#!/bin/bash

# quattro:summary=Install Steam and graphics drivers selected for this system
# quattro:requires-sudo=true

set -e

echo "Installing Steam..."

# Install the lib32 drivers first. Steam depends on the virtual package
# lib32-vulkan-driver, and quattro-pkg-add runs pacman with --noconfirm, which
# resolves an unsatisfied virtual dependency to the first provider without
# asking. That provider is currently lib32-nvidia-utils, so installing Steam
# ahead of the drivers pulls the NVIDIA stack onto machines that have no NVIDIA
# GPU.
quattro-install-gaming-gpu-lib32
quattro-pkg-add steam
quattro-lifecycle-dispatch post-install steam

echo ""
echo "Steam will start automatically now. This might take a while..."

setsid uwsm-app -- gtk-launch steam >/dev/null 2>&1 &
