#!/bin/bash

# quattro:summary=Pick a webcam and start a screen recording with it
# quattro:examples=quattro capture screenrecording-with-webcam

mapfile -t devices < <(quattro-capture-webcam-list)
if (( ${#devices[@]} == 0 )); then
  quattro-notification-send "$(quattro-i18n capture.noWebcam)" -u critical -t 3000
  exit 1
fi

if (( ${#devices[@]} == 1 )); then
  device="${devices[0]%%[[:space:]]*}"
else
  selection=$(quattro-menu-select "$(quattro-i18n capture.selectWebcam)" "${devices[@]}" -- --width 520 --maxheight 520) || exit 1
  device="${selection%%[[:space:]]*}"
fi

exec quattro-capture-screenrecording \
  --with-desktop-audio --with-microphone-audio \
  --with-webcam --webcam-device="$device"
