#!/bin/bash

# quattro:summary=Show idle, screensaver, and lock diagnostics
# quattro:group=debug
# quattro:args=[log-lines]
# quattro:examples=quattro debug idle | quattro-debug-idle 400

lines=${1:-200}
if [[ ! $lines =~ ^[0-9]+$ ]]; then
  lines=200
fi

section() {
  printf '\n== %s ==\n' "$1"
}

section "Time"
date -Is

section "Idle IPC status"
quattro-shell idle status 2>&1 | jq . 2>/dev/null || quattro-shell idle status 2>&1 || true

section "Shell instances"
pgrep -a -u "$UID" -x quattro-cpp 2>&1 || true

section "Persisted shell log"
journalctl -t quattro-shell -n "$lines" --no-pager --quiet 2>/dev/null || true

section "Relevant processes"
ps -eo pid=,args= \
  | grep -E 'quattro-cpp|quattro-system-sleep-monitor|systemd-inhibit.*Lock screen before suspend|quattro-screensaver' \
  | grep -v grep || true

section "Sleep lock service"
systemctl --user status quattro-sleep-lock.service --no-pager 2>/dev/null || true

section "Hyprland screensaver layers"
hyprctl layers -j 2>/dev/null \
  | jq -r '.. | objects | select(.namespace? == "org.quattro.screensaver") | [.pid,.namespace,.x,.y,.w,.h] | @tsv' || true

section "Idle inhibitors"
hyprctl clients -j 2>/dev/null \
  | jq -r '.[] | select(.inhibitingIdle == true or ((.tags // []) | index("noidle"))) | [.pid,.class,.title,((.tags // []) | join(",")),.inhibitingIdle] | @tsv' || true

section "Screensaver detector"
if hyprctl layers -j 2>/dev/null | jq -e '[.. | objects | select(.namespace? == "org.quattro.screensaver")] | length > 0' >/dev/null; then
  echo "running-layer"
elif pgrep -f '[/]usr/lib/quattro-screensaver/quattro-screensaver' >/dev/null; then
  echo "running-process"
elif quattro-toggle-enabled screensaver-off; then
  echo "disabled"
else
  echo "stopped"
fi

section "Lock detector"
quattro-shell lock status 2>&1 | jq . 2>/dev/null || quattro-shell lock status 2>&1 || true
