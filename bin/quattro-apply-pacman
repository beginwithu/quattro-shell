#!/bin/bash

# Custom repository and pacman.conf template application are disabled so the
# system's existing /etc/pacman.conf and /etc/pacman.d/mirrorlist remain untouched.

set -euo pipefail

if [[ ${1:-} == "--render" ]]; then
  echo "quattro-apply-pacman: rendering custom Quattro pacman repositories is disabled." >&2
  exit 1
fi

echo "Preserving existing /etc/pacman.conf and /etc/pacman.d/mirrorlist (custom Quattro repo disabled)."
