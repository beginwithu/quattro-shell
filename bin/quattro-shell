#!/bin/bash

# quattro:summary=Send an IPC call to the running Quattro shell
# quattro:args=[-q] <target> <method> [args...]
# quattro:examples=quattro shell shell ping | quattro-shell shell toggle quattro.menu '{"menu":"root"}'

QUIET=0
if [[ ${1:-} == "-q" ]]; then
  QUIET=1
  shift
fi

fail() {
  (( QUIET )) && exit 0
  echo "$1" >&2
  exit 1
}

if (( $# == 0 )) || [[ $1 == "-h" || $1 == "--help" ]]; then
  cat <<USAGE
Usage: quattro-shell [-q] <target> <method> [args...]

Forwards an IPC call to the running Quattro shell. The shell is expected
to already be running; this command does not start it.

Options:
  -q  Quiet best-effort mode. Suppress output and return success even when
      the shell, target, method, or arguments are unavailable.

Examples:
  quattro-shell shell ping
  quattro-shell -q quattro.indicators refresh
  quattro-shell shell listPlugins
  quattro-shell shell toggle quattro.menu '{"menu":"root"}'
USAGE
  exit 0
fi

(( $# >= 2 )) || fail "Usage: quattro-shell <target> <method> [args...]"
[[ -n ${QUATTRO_PATH:-} ]] || fail "QUATTRO_PATH is not set"
[[ -d $QUATTRO_PATH ]] || fail "quattro-shell runtime not found: $QUATTRO_PATH"

# qs matches instances by display, and a caller from outside the session (an
# ssh or TTY quattro-restart-shell, and the migrations it runs for) has none,
# so recover it from the compositor socket. A display whose socket is gone is
# no better: a second Hyprland session, say one started from a TTY, leaves its
# own in the systemd user environment, and services started after it would
# otherwise never reach the shell.
# A display may also be an absolute path to its socket.
runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$UID}"
display_socket=${WAYLAND_DISPLAY:-}
[[ $display_socket == /* ]] || display_socket="$runtime_dir/$display_socket"
if [[ -z ${WAYLAND_DISPLAY:-} || ! -e $display_socket ]]; then
  socket=$(ls -t "$runtime_dir"/wayland-[0-9]* 2>/dev/null | grep -v '\.lock$' | head -n1)
  [[ -n $socket ]] && export WAYLAND_DISPLAY=${socket##*/}
fi

if [[ $1 == "shell" && ( $2 == "summon" || $2 == "toggle" ) ]] && (( $# == 3 )); then
  set -- "$1" "$2" "$3" "{}"
fi

# The shell answers on its own socket first: socat starts in ~5ms where a qs
# ipc client takes ~45ms. Fields are split by unit separators and the request
# ends with a record separator, so an argument holding either goes through qs
# ipc instead. The shell replies "OK" with the output once the call has run,
# or "SKIP" when it ran nothing (no such target or function, the wrong number
# of arguments), and qs ipc then gives its exact answer. A timeout after the
# request is out is reported, not retried: the call may already have run.
# Like qs ipc, the socket belongs to one shell, the one running this config on
# this display, and the shell derives its name from the same two values.
socket_id=$(printf '%s\n%s' "$QUATTRO_PATH/shell" "${WAYLAND_DISPLAY:-}" | md5sum)
socket="${XDG_RUNTIME_DIR:-/run/user/$UID}/quattro-shell-${socket_id:0:16}.sock"
request="$*"
# Direct UNIX-socket IPC served natively by quattro-cpp.
[[ -S $socket ]] || fail "quattro-shell is not running"
command -v socat >/dev/null 2>&1 || fail "quattro-shell requires socat for IPC"

saved_ifs=$IFS
IFS=$'\x1f'
request="$*"
IFS=$saved_ifs
reply=$(printf '%s\x1e' "$request" | timeout --kill-after=1s "${QUATTRO_SHELL_IPC_TIMEOUT:-2s}" socat -t 86400 - "UNIX-CONNECT:$socket" 2>&1)

if [[ $reply == OK$'\x1f'*$'\x1e'* ]]; then
  output=${reply#OK$'\x1f'}
  output=${output%$'\x1e'*}
  while [[ $output == *$'\n' ]]; do output=${output%$'\n'}; done
  if (( !QUIET )) && [[ -n $output ]]; then
    echo "$output"
  fi
  exit 0
elif [[ $reply == ERROR$'\x1f'*$'\x1e'* ]]; then
  err=${reply#ERROR$'\x1f'}
  err=${err%$'\x1e'*}
  fail "${err:-quattro-shell IPC call failed}"
elif [[ $reply == "SKIP"$'\x1e'* ]]; then
  fail "Target or method not found: $1 $2"
elif [[ $reply != OK* && ( $reply == *" E connect("* || $reply == *"Connection refused"* || $reply == *"No such file or directory"* ) ]]; then
  fail "quattro-shell is not running"
else
  fail "quattro-shell is not responding"
fi
