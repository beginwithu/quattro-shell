#!/bin/bash

# quattro:summary=Select input methods for Japanese, Korean, or Chinese typing
# quattro:args=[mozc|hangul|pinyin|chewing|cangjie5]
# quattro:examples=quattro setup input | quattro setup input mozc
# quattro:requires-sudo=true

set -euo pipefail

if (( $# > 1 )); then
  echo "Usage: quattro setup input [mozc|hangul|pinyin|chewing|cangjie5]" >&2
  exit 1
fi

method=${1:-}
if [[ -z $method ]]; then
  /usr/bin/python3 "$QUATTRO_PATH/default/input-methods/typing_setup.py" input
  exit
fi

case "$method" in
  mozc | hangul | pinyin | chewing | cangjie5) ;;
  *) echo "Unknown input method: $method" >&2; exit 1 ;;
esac

mapfile -t packages < <(jq -r --arg method "$method" '.[$method].packages[]' "$QUATTRO_PATH/default/input-methods/presets.json")
quattro-pkg-add "${packages[@]}"
/usr/bin/python3 "$QUATTRO_PATH/default/input-methods/typing_setup.py" add "$method"
echo "Input method added. Use Super+I or the Japanese/Korean input key to switch; existing custom Fcitx keys are preserved."
