#!/bin/bash

# quattro:summary=Log out, reboot or shut down
# quattro:args=<logout|reboot|shutdown>

case "${1:-}" in
  logout)
    # Ask Hyprland first, since it knows how to end its own session cleanly.
    if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] && command -v hyprctl >/dev/null 2>&1; then
      [[ $(hyprctl dispatch exit 2>&1) == ok ]] && exit 0
      [[ $(hyprctl dispatch 'hl.dsp.exit()' 2>&1) == ok ]] && exit 0
    fi
    exec loginctl terminate-session "${XDG_SESSION_ID:-self}" ;;
  reboot) exec systemctl reboot ;;
  shutdown) exec systemctl poweroff ;;
  *) echo "Usage: quattro-system <logout|reboot|shutdown>" >&2; exit 1 ;;
esac
