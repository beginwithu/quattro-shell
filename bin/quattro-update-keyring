#!/bin/bash

# quattro:summary=Ensure the Quattro, Arch and (on aarch64) Arch Linux ARM keyring packages are installed and populated
# quattro:requires-sudo=true

# quattro-update runs this under set -e as a trusted pre-step, so a failed key
# lookup or a broken keyring has to stop this script here, not surface later as
# signature errors in the middle of the main transaction.
set -euo pipefail

# Quattro's packaging key comes from Quattro's own Web Key Directory for
# pkgs@quattro.org, never a public keyserver, so it is always the current key
# with its current subkeys. Only the pinned fingerprint is added: a different
# key there fails the lsign below instead of being trusted.
# A subshell, so its trap cleans up the temporary keyring and its gpg daemons
# however a step fails under set -e. A failed daemon kill must neither skip
# the removal nor replace the subshell's own exit status.
add_quattro_key() (
  GNUPGHOME=$(mktemp -d)
  export GNUPGHOME
  trap 'gpgconf --kill all 2>/dev/null || true; rm -rf "$GNUPGHOME"' EXIT
  gpg --batch --quiet --auto-key-locate clear,nodefault,wkd --locate-external-keys pkgs@quattro.org
  gpg --batch --export 40DFB630FF42BCFFB047046CF0134EE680CAC571 >"$GNUPGHOME/quattro.gpg"
  sudo pacman-key --add "$GNUPGHOME/quattro.gpg"
)

if quattro-pkg-missing quattro-keyring || ! sudo pacman-key --list-keys 40DFB630FF42BCFFB047046CF0134EE680CAC571 &>/dev/null; then
  add_quattro_key
  sudo pacman-key --lsign-key 40DFB630FF42BCFFB047046CF0134EE680CAC571

  # This is generally not a good idea, but this is a special case because we're going to be updating
  # the full set of packages in quattro-update-system-pkgs right after this (and it needs latest keyring)!
  sudo pacman -Sy
  quattro-pkg-add quattro-keyring

  sudo pacman-key --list-keys 40DFB630FF42BCFFB047046CF0134EE680CAC571
fi

# Arch Linux ARM signs every package in its repositories, archlinux-keyring
# included, with its build key, and only archlinuxarm-keyring carries it.
# pacman's "Import PGP key?" prompt adds that key without trusting it, after
# which every update stops at "unknown trust", so check that it is valid, not
# just present: populate it from the installed keyring, or add the copy
# Quattro ships and sign it locally when the package is missing, then install
# the package with the refresh below. The shipped copy needs no keyserver:
# keyserver.ubuntu.com, the only one that carried it, went down with the rest
# of Canonical on 11 November 2026, and a failed fetch stops this update.
alarm_key=68B3537F39A313B3E574D06777193F152BDBE6A6
alarm_keyring_missing=0

alarm_key_trusted() {
  [[ $(sudo gpg --homedir /etc/pacman.d/gnupg --no-permission-warning --batch --with-colons --list-keys "$alarm_key" 2>/dev/null) =~ (^|$'\n')pub:[fu]: ]]
}

if quattro-hw-aarch64 && ! alarm_key_trusted; then
  if quattro-pkg-present archlinuxarm-keyring; then
    sudo pacman-key --populate archlinuxarm
  else
    sudo pacman-key --add "$QUATTRO_PATH/default/pacman/keys/$alarm_key.asc"
    sudo pacman-key --lsign-key "$alarm_key"
    alarm_keyring_missing=1
  fi
fi

# Ensure we have the latest archlinux-keyring and quattro-keyring, maintainer
# keys might have changed.
# --needed installs only a newer keyring: new or revoked keys reach the repos
# as a new package version, and an installed version was populated when it
# went in, so reinstalling the same one only repeats that populate.
# An aarch64 machine's Arch Linux ARM repositories are signed with keys of
# their own, so its keyring is kept current the same way.
keyrings=(archlinux-keyring quattro-keyring)
if quattro-hw-aarch64 && { quattro-pkg-present archlinuxarm-keyring || (( alarm_keyring_missing )); }; then
  keyrings+=(archlinuxarm-keyring)
fi
# A platform package names the signing keyrings of the repositories it adds,
# one package per line. Only installed ones are refreshed, so this adds no
# repository the machine didn't already trust; a refreshed keyring may carry
# that repository's new keys. A line that isn't one keyring package name is
# skipped with a warning, so a mistake in the list can't stop every update.
platform_keyrings=/usr/share/quattro-platform/keyrings
if [[ -f $platform_keyrings ]]; then
  while read -r keyring extra || [[ -n $keyring ]]; do
    [[ -n $keyring && $keyring != \#* ]] || continue
    if [[ -n $extra || ! $keyring =~ ^[a-z0-9][a-z0-9@._+-]*-keyring$ ]]; then
      echo "Warning: skipping ${keyring}${extra:+ $extra} in $platform_keyrings: not a keyring package name" >&2
      continue
    fi
    if quattro-pkg-present "$keyring" && [[ " ${keyrings[*]} " != *" $keyring "* ]]; then
      keyrings+=("$keyring")
    fi
  done <"$platform_keyrings"
fi
echo -e "\e[32m\nUpdate signing keys\e[0m"
sudo pacman -Sy --needed --noconfirm "${keyrings[@]}" >/dev/null 2> >(grep -vE '^warning: [a-z0-9@._+-]+-keyring-[^ ]+ is up to date -- skipping$' >&2)

if quattro-hw-aarch64 && ! alarm_key_trusted; then
  echo "Arch Linux ARM's signing key $alarm_key is still not trusted" >&2
  exit 1
fi

# Say "correct" only once the key verifiably is: before the failure checks
# above, a failed recv or reinstall still ended here with exit 0.
sudo pacman-key --list-keys 40DFB630FF42BCFFB047046CF0134EE680CAC571 >/dev/null
echo "Keys are correct"
