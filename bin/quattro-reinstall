#!/bin/bash

# quattro:summary=Reinstall Quattro packages and reset default configs
# quattro:requires-sudo=true

set -e

echo -e "This will reinstall all default Quattro packages and reset default configs.\nWarning: user config changes will be overwritten.\n"

if gum confirm "Are you sure you want to reinstall and lose config changes?"; then
  quattro-reinstall-pkgs
  quattro-reinstall-configs

  gum confirm "System has been reinstalled. Reboot?" && quattro-system reboot
fi
