#!/bin/bash

# quattro:summary=Apply the current theme's icon theme to Qt apps
# quattro:hidden=true

set -euo pipefail

# qtengine follows the theme's qtengine.colors on its own, but takes the icon
# theme from its config. Only that key is written, so the rest of the file stays
# the user's, and the write is what makes running Qt apps reload their icons.
CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/qtengine/config.json"

[[ -f $CONFIG ]] || exit 0
command -v jq >/dev/null 2>&1 || exit 0

# The same icons quattro-theme-set-gnome gives GTK: Adwaita, for every theme.
icon_theme="Adwaita"

if [[ $(jq -r '.theme.iconTheme // empty' "$CONFIG") == "$icon_theme" ]]; then
  exit 0
fi

# Write through a dotfiles symlink rather than replacing it.
config=$(realpath "$CONFIG")
if ! jq --arg icon_theme "$icon_theme" '.theme.iconTheme = $icon_theme' "$config" >"$config.quattro-tmp"; then
  rm -f "$config.quattro-tmp"
  exit 1
fi
mv "$config.quattro-tmp" "$config"
