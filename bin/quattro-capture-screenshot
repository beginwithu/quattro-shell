#!/bin/bash

# quattro:summary=Take a screenshot
# quattro:group=capture
# quattro:args=[smart|region|windows|fullscreen|scroll] [copy|save]
# quattro:examples=quattro screenshot | quattro capture screenshot region
# quattro:aliases=quattro screenshot

if [[ -n ${QUATTRO_SCREENSHOT_DIR:-} && -z ${OMASNAP_SCREENSHOT_DIR:-} ]]; then
  export OMASNAP_SCREENSHOT_DIR="$QUATTRO_SCREENSHOT_DIR"
fi

# --notify announces saved shots with Open and Edit buttons instead of a
# preview. Omasnap reads that toast's text from this catalog itself:
#   quattro-i18n capture.screenshotSaved, quattro-i18n capture.screenshotSavedCopied,
#   quattro-i18n capture.screenshotOpen, quattro-i18n capture.screenshotEdit
omasnap_args=(--notify)
for arg in "$@"; do
  case "$arg" in
    copy) omasnap_args+=(--copy) ;;
    save) omasnap_args+=(--save) ;;
    slurp) ;;
    *) omasnap_args+=("$arg") ;;
  esac
done

if command -v omasnap >/dev/null 2>&1; then
  exec omasnap "${omasnap_args[@]}"
fi

# Fallback for standard Arch Linux (using quattro-capture-region + grim + wl-copy)
SCREENSHOT_DIR="${QUATTRO_SCREENSHOT_DIR:-${OMASNAP_SCREENSHOT_DIR:-${XDG_PICTURES_DIR:-$HOME/Pictures}/Screenshots}}"
mkdir -p "$SCREENSHOT_DIR"

mode="smart"
action="both"
for arg in "$@"; do
  case "$arg" in
    smart|region|windows|fullscreen) mode="$arg" ;;
    output) mode="fullscreen" ;;
    copy) action="copy" ;;
    save) action="save" ;;
  esac
done

out_file="$SCREENSHOT_DIR/screenshot-$(date +'%Y-%m-%d_%H-%M-%S').png"

freeze_pid=""
cleanup_freeze() {
  [[ -n $freeze_pid ]] && kill "$freeze_pid" 2>/dev/null || true
}
trap cleanup_freeze EXIT

if command -v quattro-capture-region >/dev/null 2>&1; then
  mapfile -t region_out < <(quattro-capture-region "$mode" --keep-freeze 2>/dev/null) || exit 0
  freeze_pid="${region_out[0]:-}"
  geom="${region_out[1]:-}"
else
  geom=$(slurp 2>/dev/null) || exit 0
fi

[[ -n $geom ]] || exit 0
grim -g "$geom" "$out_file" || exit 1
cleanup_freeze
freeze_pid=""

if [[ $action == "copy" ]]; then
  wl-copy < "$out_file"
  rm -f "$out_file"
  command -v quattro-notification-send >/dev/null 2>&1 && quattro-notification-send "Screenshot copied to clipboard" -t 2000 || true
else
  wl-copy < "$out_file" 2>/dev/null || true
  if command -v quattro-notification-send >/dev/null 2>&1; then
    quattro-notification-send "Screenshot saved" "$out_file" -i "$out_file" -t 3000 || true
  fi
fi
