#!/bin/bash

# quattro:summary=Show which theme is styling the Plymouth boot screen
# quattro:examples=quattro plymouth current

# quattro-plymouth-set installs the theme's unlock.png as a byte-for-byte
# copy of logo.png, so matching it back identifies the current theme.
installed_logo=/usr/share/plymouth/themes/quattro/logo.png

if cmp -s "$QUATTRO_PATH/default/plymouth/logo.png" "$installed_logo"; then
  echo default
  exit
fi

quattro-plymouth-list | while read -r name; do
  if cmp -s "$(quattro-theme-dir "$name")/unlock.png" "$installed_logo"; then
    echo "$name"
    exit
  fi
done
