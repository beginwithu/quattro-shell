#!/bin/bash

# quattro:summary=Print the directory holding a theme, preferring a user-installed copy
# quattro:args=<theme-name>
# quattro:examples=quattro theme dir tokyo-night

theme="${1:-}"

if [[ -z $theme ]]; then
  echo "Usage: quattro-theme-dir <theme-name>" >&2
  exit 1
fi

if [[ -d $HOME/.config/quattro/themes/$theme ]]; then
  echo "$HOME/.config/quattro/themes/$theme"
else
  echo "$QUATTRO_PATH/themes/$theme"
fi
