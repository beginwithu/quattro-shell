#!/bin/bash

# quattro:summary=Launch Slack with live Quattro theme support
# quattro:args=[slack-arguments...]
# quattro:hidden=true

# Slack's own restarts come back through here with the pipe flag the
# launcher added; the launcher adds it again with a pipe behind it.
arguments=()
for argument in "$@"; do
  [[ $argument == "--remote-debugging-pipe" ]] || arguments+=("$argument")
done

if [[ -f $HOME/.local/state/quattro/slack/enabled ]]; then
  exec /usr/bin/python "$QUATTRO_PATH/default/slack/launcher.py" "${arguments[@]}"
else
  exec /usr/bin/slack "${arguments[@]}"
fi
