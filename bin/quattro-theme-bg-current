#!/bin/bash

# quattro:summary=Show current background
# quattro:examples=quattro theme bg current

BACKGROUND_PATH=$(readlink -f "$HOME/.local/state/quattro/current/background" 2>/dev/null)

if [[ -n $BACKGROUND_PATH ]]; then
  basename -- "$BACKGROUND_PATH" | perl -pe 's/\.[^.]+$//; s/^\d+-//; s/-/ /g; s/\b(\w)/\U$1/g'
else
  echo "Unknown"
fi
