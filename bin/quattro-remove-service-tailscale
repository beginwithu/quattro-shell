#!/bin/bash

# quattro:summary=Remove Tailscale and its bar plugin.
# quattro:requires-sudo=true

tailscale down 2>/dev/null || true
systemctl --user disable --now quattro-tailscale-receive.service 2>/dev/null || true
sudo systemctl disable --now tailscaled.service 2>/dev/null || true
quattro-plugin-disable quattro.tailscale
quattro-webapp-remove "Tailscale" 2>/dev/null || true
quattro-pkg-drop tailscale

echo ""
echo "Tailscale has been removed."
