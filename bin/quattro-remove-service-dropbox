#!/bin/bash

# quattro:summary=Remove Dropbox and its bar plugin.
# quattro:requires-sudo=true

dropbox-cli stop 2>/dev/null || true
quattro-plugin-disable quattro.dropbox
quattro-pkg-drop dropbox dropbox-cli python-gpgme nautilus-dropbox

# Other tray apps need libappindicator too, and naming a required package fails the whole removal
if pacman -Qqtt libappindicator &>/dev/null; then
  quattro-pkg-drop libappindicator
fi

echo ""
echo "Dropbox has been removed."
