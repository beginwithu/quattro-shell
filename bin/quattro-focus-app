#!/bin/bash

# quattro:summary=Focus the most recently used Hyprland window whose class matches
# quattro:args=<app-name>
app=${1:-}
[[ -n $app ]] || { echo "Usage: quattro-focus-app <app-name>" >&2; exit 1; }
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || exit 1

address=$(hyprctl clients -j 2>/dev/null | jq -r --arg pattern "$app" '
  sort_by(.focusHistoryID)
  | first(.[] | select((.class // "") | test($pattern; "i"))).address // empty')
[[ -n $address && $address =~ ^0x[0-9a-fA-F]+$ ]] || exit 1

[[ $(hyprctl dispatch "hl.dsp.focus({ window = hl.get_window(\"address:$address\") })" 2>&1) == ok ]] || \
  [[ $(hyprctl dispatch focuswindow "address:$address" 2>&1) == ok ]]
