#!/bin/bash

# quattro:summary=Remove the xpadneo Xbox controller driver and undo its module/blacklist config.
# quattro:group=remove
# quattro:name=gaming xbox-controllers
# quattro:requires-sudo=true

set -e

quattro-pkg-drop xpadneo-dkms

sudo rm -f /etc/modprobe.d/blacklist-xpad.conf /etc/modules-load.d/xpadneo.conf

echo ""
echo "Xbox controller support removed. Reboot to fully unload xpadneo and restore xpad."
