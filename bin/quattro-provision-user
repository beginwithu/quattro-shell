#!/bin/bash

# quattro:summary=Finalize Quattro user setup (runtime tweaks /etc/skel can't do)
# quattro:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: quattro finalize user [--force] [--first-install]

Runs the per-user setup steps that /etc/skel can't seed:
dev-aware skill symlinks, xdg-user-dirs + gtk bookmarks (need \$HOME),
default browser/mailto, and install/user/all.sh.

For shipped configs see /etc/skel (new users) and quattro-reinstall-configs
(existing users explicitly resyncing).

--first-install is used by the ISO in the target chroot. It marks shipped
migrations complete for the freshly-created user.

Idempotency marker: ~/.local/state/quattro/done/finalize-user
USAGE
}

if (( EUID == 0 )); then
  echo "Error: run quattro-provision-user as the user being configured, not as root." >&2
  exit 1
fi

force=0
first_install=0
while (($#)); do
  case "$1" in
    --force)
      force=1
      shift
      ;;
    --first-install)
      first_install=1
      force=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

state_dir="$HOME/.local/state/quattro"
mkdir -p "$state_dir"

if quattro-done check finalize-user && (( force == 0 )); then
  echo "User finalization already complete."
  exit 0
fi

export QUATTRO_PATH="${QUATTRO_PATH:-/usr/share/quattro}"
export QUATTRO_INSTALL="${QUATTRO_INSTALL:-$QUATTRO_PATH/install}"
export QUATTRO_SETUP_CONTEXT="${QUATTRO_SETUP_CONTEXT:-runtime}"
export PATH="$QUATTRO_PATH/bin:$PATH"

if (( first_install )) && [[ $QUATTRO_SETUP_CONTEXT == "runtime" ]]; then
  # The ISO chroot doesn't set a context; quattro-provision-owner runs first-install
  # finalization too but with QUATTRO_SETUP_CONTEXT=provision-owner already set.
  export QUATTRO_SETUP_CONTEXT=iso-chroot
fi

if [[ -n ${QUATTRO_INSTALL_LOG_FILE:-} && -f $QUATTRO_INSTALL/helpers/logging.sh ]]; then
  source "$QUATTRO_INSTALL/helpers/logging.sh"
else
  run_logged() {
    local script="$1"
    bash -eE -c 'source "$1"' bash "$script"
  }
fi

mkdir -p ~/Downloads ~/Pictures ~/Videos ~/.config/gtk-3.0
xdg-user-dirs-update --set TEMPLATES "$HOME"
xdg-user-dirs-update --set PUBLICSHARE "$HOME"
xdg-user-dirs-update --set DESKTOP "$HOME"
# Name the rest now, so a first login in another language does not create
# translated folders beside the English ones Quattro made and bookmarked. A
# folder the user already named, in any language, stays theirs.
for dir in DOWNLOAD:Downloads PICTURES:Pictures VIDEOS:Videos DOCUMENTS:Documents MUSIC:Music; do
  # Created too: xdg-user-dirs resets a named folder that does not exist.
  grep -q "^XDG_${dir%%:*}_DIR=" "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" 2>/dev/null ||
    { mkdir -p "$HOME/${dir#*:}" && xdg-user-dirs-update --set "${dir%%:*}" "$HOME/${dir#*:}"; }
done
rmdir ~/Templates ~/Public ~/Desktop 2>/dev/null || true
touch ~/.config/gtk-3.0/bookmarks
for dir in Downloads Projects Pictures Videos; do
  bookmark="file://$HOME/$dir $dir"
  grep -qxF "$bookmark" ~/.config/gtk-3.0/bookmarks || echo "$bookmark" >>~/.config/gtk-3.0/bookmarks
done

source "$QUATTRO_INSTALL/user/all.sh"

quattro-refresh-applications
env -u BROWSER XDG_CURRENT_DESKTOP= xdg-settings set default-web-browser google-chrome.desktop
xdg-mime default HEY.desktop x-scheme-handler/mailto

if (( first_install )); then
  mkdir -p "$state_dir/migrations"
  for migration in "$QUATTRO_PATH"/migrations/*.sh; do
    [[ -f $migration ]] && touch "$state_dir/migrations/$(basename "$migration")"
  done
fi

quattro-done mark finalize-user
echo "User finalization complete."
