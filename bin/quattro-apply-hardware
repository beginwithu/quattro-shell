#!/bin/bash

# quattro:summary=Apply Quattro hardware-specific packages and system configuration
# quattro:group=apply
# quattro:requires-sudo=true
# quattro:examples=quattro apply hardware --install-user dhh
# quattro:hidden=true

set -euo pipefail

usage() {
  cat <<USAGE
Usage: quattro apply hardware --install-user USER
       quattro apply hardware --defer-provisioning

Runs idempotent hardware detection/setup for the installed machine. This is
called by quattro-apply-system during ISO finalization and can be rerun later
for diagnostics or after hardware/package updates.

--defer-provisioning runs without an install user (deferred-provisioning installs create the user at
first boot); group grants are recorded in /var/lib/quattro/provisioning/groups.

In an image build (/var/lib/quattro/image/target exists) nothing runs here: every step is queued
for quattro-provision-hardware on the machine's first boot.
USAGE
}

install_user="${QUATTRO_INSTALL_USER:-}"
defer_provisioning=0
while (($#)); do
  case "$1" in
    --install-user)
      install_user="${2:-}"
      shift 2
      ;;
    --defer-provisioning)
      defer_provisioning=1
      shift
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if (( EUID != 0 )); then
  echo "Error: quattro-apply-hardware must run as root" >&2
  exit 1
fi

if (( defer_provisioning )); then
  install_user=""
else
  if [[ -z $install_user || $install_user == "root" ]]; then
    echo "Error: --install-user must name the target non-root user" >&2
    exit 1
  fi

  if ! getent passwd "$install_user" >/dev/null; then
    echo "Error: user '$install_user' does not exist" >&2
    exit 1
  fi
fi

export QUATTRO_INSTALL_USER="$install_user"
# Only quattro-provision-hardware runs steps as an image's first boot.
unset QUATTRO_IMAGE_DEFERRED_HARDWARE
export QUATTRO_PATH="${QUATTRO_PATH:-/usr/share/quattro}"
export QUATTRO_INSTALL="${QUATTRO_INSTALL:-$QUATTRO_PATH/install}"
export QUATTRO_INSTALL_LOG_FILE="${QUATTRO_INSTALL_LOG_FILE:-/var/log/quattro-install.log}"
export PATH="$QUATTRO_PATH/bin:$PATH"

source "$QUATTRO_INSTALL/helpers/logging.sh"
source "$QUATTRO_INSTALL/helpers/image-target.sh"

quattro_image_init
quattro_image_lock
if quattro_image_manifest_present; then
  quattro_image_read_manifest
  quattro_image_defer_hardware
else
  source "$QUATTRO_INSTALL/hardware/all.sh"
fi
