#!/bin/bash

# quattro:summary=Show the Quattro Quickshell on-screen display
# quattro:args=[-i|--icon <icon>] [-m|--message <text>] [-p|--progress <0-100>] [-d|--duration <ms>]
# quattro:examples=quattro osd -i brightness -p 50 | quattro osd -m "Hello"

set -euo pipefail

icon=""
message=""
progress=""
progress_text=""
max="100"
duration=""

usage() {
  echo "Usage: quattro-osd [-i|--icon <icon>] [-m|--message <text>] [-p|--progress <0-100>] [-d|--duration <ms>]"
}

while (($#)); do
  case $1 in
    -i|--icon) (($# >= 2)) || { usage >&2; exit 1; }; icon=$2; shift 2 ;;
    -m|--message) (($# >= 2)) || { usage >&2; exit 1; }; message=$2; shift 2 ;;
    -p|--progress) (($# >= 2)) || { usage >&2; exit 1; }; progress=$2; shift 2 ;;
    -d|--duration) (($# >= 2)) || { usage >&2; exit 1; }; duration=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown OSD option: $1" >&2; usage >&2; exit 1 ;;
  esac
done

if [[ -n $progress ]]; then
  # Shown as given, so the number takes the language's digits here.
  progress_text="$(quattro-i18n --number "$progress" 2>/dev/null || printf '%s' "$progress")%"
fi

payload=$(jq -cn \
  --arg icon "$icon" \
  --arg message "$message" \
  --arg value "$progress" \
  --arg progressText "$progress_text" \
  --arg max "$max" \
  --arg duration "$duration" \
  '{icon:$icon,message:$message,value:$value,progressText:$progressText,max:$max,duration:$duration}')

quattro-shell -q osd show "$payload"
