#!/bin/bash

# quattro:summary=Hold a sleep delay inhibitor and lock the session before every suspend
#
# Run as a user service (default/systemd/user/quattro-sleep-lock.service). It
# takes a logind delay inhibitor, waits for PrepareForSleep, locks, then lets go
# so the machine can suspend, and takes a new one after resume.

command -v systemd-inhibit >/dev/null 2>&1 || exit 1
command -v dbus-monitor >/dev/null 2>&1 || { echo "quattro-sleep-lock-monitor: dbus-monitor is required" >&2; exit 1; }

hold_and_lock() {
  # A coprocess rather than a pipe: a pipe would make us wait for dbus-monitor
  # to exit, which only happens at the next signal, after the machine has slept.
  coproc MON { dbus-monitor --system "type='signal',interface='org.freedesktop.login1.Manager',member='PrepareForSleep'" 2>/dev/null; }
  local line
  while read -r line <&"${MON[0]}"; do
    [[ $line == *"boolean true"* ]] && break
  done
  quattro-system-sleep-lock
  kill "$MON_PID" 2>/dev/null
}
export -f hold_and_lock

while true; do
  systemd-inhibit --what=sleep --mode=delay --who=quattro-shell \
    --why="Lock the session before suspend" bash -c hold_and_lock
  sleep 1
done
