#!/bin/bash

# quattro:summary=Overwrite the user config for the Plymouth drive decryption and boot sequence with the Quattro default and rebuild it.
# quattro:requires-sudo=true

# Reuse the fixed-file publisher so root never resolves the source checkout or
# follows a destination symlink while restoring the packaged assets.
exec "$QUATTRO_PATH/bin/quattro-plymouth-set" --refresh-default
