# Core packages for running Quattro configs, Hyprland (Lua), Quickshell,
# terminals, theming, and shell tools on pure Arch Linux.
# Every package here is in official Arch [core]/[extra] repositories.

# Wayland compositor & desktop shell
hyprland
hyprland-guiutils
hyprpicker
hyprsunset
quickshell
uwsm
xdg-desktop-portal-gtk
xdg-desktop-portal-hyprland
xdg-terminal-exec
xdg-user-dirs

# Qt / GTK / theming / fonts
adwaita-fonts
fontconfig
gnome-keyring
gnome-themes-extra
libsecret
noto-fonts
noto-fonts-cjk
noto-fonts-emoji
qt6-base
qt6-declarative
qt6-imageformats
qt6-multimedia
qt6-svg
qt6-wayland
qt6ct
ttf-jetbrains-mono-nerd
woff2-font-awesome

# Terminals (foot is default in hyprland-xdg-terminals.list; alacritty/kitty/ghostty also configured)
alacritty
foot
ghostty
kitty

