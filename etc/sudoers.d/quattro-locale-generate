# Picking a language under Setup > Language is a menu click, so generating its
# locale the first time must not stop for a password. The rule names each
# registry code as the whole argument (no wildcard), and the helper reads the
# locale only from the packaged registry, so the grant can do nothing but
# generate one of Quattro's 50 languages. test/shell.d/sudoers-test.sh keeps
# this list equal to default/i18n/locales.json.
%wheel ALL=(root) NOPASSWD: /usr/bin/quattro-locale-generate ar, /usr/bin/quattro-locale-generate bg, /usr/bin/quattro-locale-generate bn, /usr/bin/quattro-locale-generate ca, /usr/bin/quattro-locale-generate cs, /usr/bin/quattro-locale-generate da, /usr/bin/quattro-locale-generate de, /usr/bin/quattro-locale-generate el, /usr/bin/quattro-locale-generate en, /usr/bin/quattro-locale-generate es-MX, /usr/bin/quattro-locale-generate et, /usr/bin/quattro-locale-generate fa, /usr/bin/quattro-locale-generate fi, /usr/bin/quattro-locale-generate fil, /usr/bin/quattro-locale-generate fr, /usr/bin/quattro-locale-generate ga, /usr/bin/quattro-locale-generate he, /usr/bin/quattro-locale-generate hi, /usr/bin/quattro-locale-generate hr, /usr/bin/quattro-locale-generate hu, /usr/bin/quattro-locale-generate id, /usr/bin/quattro-locale-generate is, /usr/bin/quattro-locale-generate it, /usr/bin/quattro-locale-generate ja, /usr/bin/quattro-locale-generate ko, /usr/bin/quattro-locale-generate lt, /usr/bin/quattro-locale-generate lv, /usr/bin/quattro-locale-generate ms, /usr/bin/quattro-locale-generate nl, /usr/bin/quattro-locale-generate no, /usr/bin/quattro-locale-generate pl, /usr/bin/quattro-locale-generate pt, /usr/bin/quattro-locale-generate pt-BR, /usr/bin/quattro-locale-generate ro, /usr/bin/quattro-locale-generate ru, /usr/bin/quattro-locale-generate si, /usr/bin/quattro-locale-generate sk, /usr/bin/quattro-locale-generate sl, /usr/bin/quattro-locale-generate sr, /usr/bin/quattro-locale-generate sv, /usr/bin/quattro-locale-generate sw, /usr/bin/quattro-locale-generate ta, /usr/bin/quattro-locale-generate th, /usr/bin/quattro-locale-generate tr, /usr/bin/quattro-locale-generate uk, /usr/bin/quattro-locale-generate ur, /usr/bin/quattro-locale-generate uz, /usr/bin/quattro-locale-generate vi, /usr/bin/quattro-locale-generate zh-CN, /usr/bin/quattro-locale-generate zh-TW
